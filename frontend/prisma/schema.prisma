generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Facility {
  id        String   @id @default(uuid())
  name      String
  apiKey    String   @unique
  createdAt DateTime @default(now())
}

model SyncEvent {
  id          String   @id
  facilityId  String
  eventType   String
  payload     String
  syncedAt    DateTime @default(now())

  @@index([facilityId])
}

model Booking {
  id              String   @id
  facilityId      String
  totalCost       Decimal  @db.Decimal(10, 2)
  processedByName String?
  createdAt       DateTime @default(now())

  @@index([facilityId])
}

model JournalEntry {
  id              String   @id
  facilityId      String
  entryType       String
  referenceId     String?
  processedByName String?
  createdAt       DateTime @default(now())
  
  lines         JournalLine[]

  @@index([facilityId])
}

model JournalLine {
  id              String   @id
  journalEntryId  String
  accountName     String
  debitAmount     Decimal  @db.Decimal(10, 2)
  creditAmount    Decimal  @db.Decimal(10, 2)

  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
}


model Product {
  id                  String   @id
  facilityId          String
  name                String
  type                String   // 'RAW_GOOD' | 'PREPARED_DISH'
  internalSku         String?
  manufacturerBarcode String?
  price               Decimal  @db.Decimal(10, 2)
  cost                Decimal  @db.Decimal(10, 2)
  stockQty            Int?
  lowStockThreshold   Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([facilityId])
}

model CheckinSession {
  sessionId       String   @id
  facilityId      String
  status          String
  payload         String
  createdAt       DateTime @default(now())
  submittedAt     DateTime?

  @@index([facilityId])
}

model CloudAdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}
